{
  "principle": "Spend helpers where they buy correctness, never where they don't. Every helper runs on the session's own model; the size of the change, not a model name, decides who is spawned; escalation is by evidence, not by habit.",
  "policy": {
    "tiers": {
      "small": {
        "maxFiles": 1,
        "maxLines": 40,
        "requires": [
          "reviewer"
        ]
      },
      "standard": {
        "maxFiles": 10,
        "maxLines": 400,
        "requires": [
          "skeptic",
          "reviewer"
        ]
      },
      "large": {
        "requires": [
          "skeptic",
          "qa",
          "worker",
          "reviewer",
          "reviewer-2"
        ]
      }
    },
    "forceStandard": [
      "ui",
      "schema",
      "highRisk"
    ],
    "escalate": {
      "reviewerRound2": {
        "whenActOnAtLeast": 2,
        "orTier": "large"
      }
    },
    "ceiling": {
      "helpersPerTask": 10
    },
    "delegatesAt": "large"
  }
}
