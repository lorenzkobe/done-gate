{
  "principle": "Spend tokens where they buy correctness, never where they don't. Defaults are the cheapest model that does the job well; escalation is by evidence, not by habit. Helpers never run on Fable.",
  "roles": {
    "skeptic": "sonnet",
    "qa": "opus",
    "reviewer": "sonnet",
    "reviewer-2": "opus",
    "arbiter": "opus",
    "worker": "sonnet"
  },
  "policy": {
    "tiers": {
      "small": {
        "maxFiles": 1,
        "maxLines": 40,
        "requires": [
          "qa",
          "reviewer"
        ]
      },
      "standard": {
        "maxFiles": 10,
        "maxLines": 400,
        "requires": [
          "skeptic",
          "qa",
          "reviewer"
        ]
      },
      "large": {
        "requires": [
          "skeptic",
          "qa",
          "reviewer",
          "reviewer:opus"
        ]
      }
    },
    "forceStandard": [
      "ui",
      "schema",
      "highRisk"
    ],
    "escalate": {
      "reviewerRound2": {
        "model": "opus",
        "whenActOnAtLeast": 2,
        "orTier": "large"
      }
    },
    "ceiling": {
      "helpersPerTask": 10
    }
  }
}
